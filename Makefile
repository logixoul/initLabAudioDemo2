CXX      = clang++
CXXFLAGS = -O2 -std=c++20 -Ilib -Ilib/imgui -MMD -MP
LDLIBS   = -lopengl32 -lgdi32 -luser32

synth.exe: main.o lib_impl.o
	$(CXX) $^ $(LDLIBS) -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

lib_impl.o: lib/lib_impl.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Header dependencies, generated by -MMD.
-include main.d lib_impl.d
